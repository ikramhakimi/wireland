{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "query", "key": "state", "value": "(?<state>[a-z0-9_-]+)" }],
      "destination": "/__preview/state-:state/:path*"
    }
  ]
}
